# Ignore everything by default. Only explicitly approved Omarchy overrides are tracked.
/*

!/.gitignore
!/.gitattributes
!/README.md
!/install.sh
!/bootstrap.sh
!/restore-omarchy-config

!/.githooks/
/.githooks/*
!/.githooks/pre-commit

!/hypr/
/hypr/*
!/hypr/*.conf

!/walker/
/walker/*
!/walker/config.toml

!/mako/
/mako/*
!/mako/config

!/waybar/
/waybar/*
!/waybar/config.jsonc
!/waybar/style.css
!/waybar/scripts/
/waybar/scripts/*
!/waybar/scripts/*.py
!/waybar/scripts/*.sh

!/omarchy/
/omarchy/*
!/omarchy/current/
/omarchy/current/*
!/omarchy/current/theme.name

!/pipewire/
/pipewire/*
!/pipewire/pipewire-pulse.conf.d/
/pipewire/pipewire-pulse.conf.d/*
!/pipewire/pipewire-pulse.conf.d/10-switch-on-connect.conf
