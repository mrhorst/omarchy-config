# Ignore everything by default. Only explicitly approved Omarchy overrides are tracked.
/*

!/.gitignore
!/.gitattributes
!/README.md
!/install.sh
!/bootstrap.sh
!/restore-omarchy-config
!/QUATTRO-UPGRADE.md
!/user-dirs.dirs

!/.githooks/
/.githooks/*
!/.githooks/pre-commit

!/hypr/
/hypr/*
!/hypr/.luarc.json
!/hypr/*.lua
!/hypr/hyprsunset.conf
!/hypr/xdph.conf

!/omarchy/
/omarchy/*
!/omarchy/shell.json
!/omarchy/shell.toml
!/omarchy/stremio-idle-guard.py
!/omarchy/plugins/
/omarchy/plugins/*
!/omarchy/plugins/mat.system-health/
/omarchy/plugins/mat.system-health/*
!/omarchy/plugins/mat.system-health/manifest.json
!/omarchy/plugins/mat.system-health/SystemHealth.qml
!/omarchy/plugins/mat.system-health/system-health.py

!/systemd/
/systemd/*
!/systemd/user/
/systemd/user/*
!/systemd/user/app-bluebubbles\@autostart.service.d/
!/systemd/user/stremio-idle-guard.service
/systemd/user/app-bluebubbles\@autostart.service.d/*
!/systemd/user/app-bluebubbles\@autostart.service.d/override.conf

!/pipewire/
/pipewire/*
!/pipewire/pipewire-pulse.conf.d/
/pipewire/pipewire-pulse.conf.d/*
!/pipewire/pipewire-pulse.conf.d/10-switch-on-connect.conf
