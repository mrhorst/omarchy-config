# Ignore everything by default. Only explicitly approved Omarchy overrides are tracked.
/*

!/.gitignore
!/.gitattributes
!/README.md
!/install.sh
!/restore-omarchy-config

!/.githooks/
/.githooks/*
!/.githooks/pre-commit

!/hypr/
/hypr/*
!/hypr/*.conf

!/walker/
/walker/*
!/walker/config.toml

!/waybar/
/waybar/*
!/waybar/config.jsonc
!/waybar/style.css
!/waybar/scripts/
/waybar/scripts/*
!/waybar/scripts/*.py
!/waybar/scripts/*.sh

!/omarchy/
/omarchy/*
!/omarchy/current/
/omarchy/current/*
!/omarchy/current/theme.name
