#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-config"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"

cd "$CONFIG_DIR"
git rev-parse --is-inside-work-tree >/dev/null
git remote get-url origin >/dev/null

mkdir -p "$STATE_DIR/backups"
chmod 700 "$STATE_DIR" "$STATE_DIR/backups"
umask 077

git fetch --prune origin main

if ! git diff --quiet HEAD -- || ! git diff --cached --quiet; then
  PATCH_FILE="$STATE_DIR/backups/pre-restore-$TIMESTAMP.patch"
  git diff HEAD --binary > "$PATCH_FILE"
  printf 'Saved uncommitted changes to %s\n' "$PATCH_FILE"
fi

if [ "$(git rev-list --count origin/main..HEAD)" -gt 0 ]; then
  BACKUP_BRANCH="backup/pre-restore-$TIMESTAMP"
  git branch "$BACKUP_BRANCH" HEAD
  printf 'Preserved unpushed commits on branch %s\n' "$BACKUP_BRANCH"
fi

git reset --hard origin/main
git config core.hooksPath .githooks

command -v hyprctl >/dev/null 2>&1 && hyprctl reload >/dev/null 2>&1 || true
command -v waybar >/dev/null 2>&1 && pkill -SIGUSR2 waybar >/dev/null 2>&1 || true

printf 'Restored Omarchy configuration from origin/main.\n'
